# =====================================================================
# CLOUD WA TOOLS - environment configuration example
# Copy to .env and adjust. NEVER commit the real .env to Git.
# Values here override config/config.json.
# =====================================================================

DATABASE_PATH=./data/database.sqlite
SESSION_PATH=./data/sessions
LOG_PATH=./logs
MESSAGE_STORAGE=./data/messages
MEDIA_STORAGE=./data/media

# --- Safe rate limits (optional overrides) ---
# Minimum delay between messages in seconds
# CLOUD_WA_MIN_DELAY=6
# Maximum delay between messages in seconds
# CLOUD_WA_MAX_DELAY=15
# Messages sent per session before automatic pause (cooldown)
# CLOUD_WA_MESSAGES_PER_SESSION=50
# Per-recipient cooldown in hours (duplicate protection)
# CLOUD_WA_COOLDOWN_HOURS=24
# Maximum retry per message on transient failure
# CLOUD_WA_MAX_RETRY=3
